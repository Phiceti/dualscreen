{
  "name": "@dualscreen/react",
  "version": "0.1.0",
  "description": "React bindings for dualscreen \u2014 hooks and components for driving a second monitor from your app.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "keywords": [
    "dualscreen",
    "react",
    "multi-monitor",
    "hooks",
    "second-screen"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phiceti/dualscreen.git",
    "directory": "packages/react"
  },
  "dependencies": {
    "@dualscreen/core": "workspace:*",
    "@dualscreen/screens": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.17",
    "react": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "homepage": "https://phiceti.github.io/dualscreen",
  "bugs": {
    "url": "https://github.com/phiceti/dualscreen/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
