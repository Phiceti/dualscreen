{
  "name": "@dualscreen/devtools",
  "version": "0.1.0",
  "description": "A drop-in overlay for inspecting dualscreen peers, shared state, and live protocol traffic.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "keywords": [
    "dualscreen",
    "devtools",
    "debug"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phiceti/dualscreen.git",
    "directory": "packages/devtools"
  },
  "dependencies": {
    "@dualscreen/core": "workspace:*",
    "@dualscreen/react": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.17",
    "react": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "homepage": "https://phiceti.github.io/dualscreen",
  "bugs": {
    "url": "https://github.com/phiceti/dualscreen/issues"
  }
}
