{
  "name": "dualscreen-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "dev": "pnpm -r --parallel --filter \"./packages/**\" dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "node scripts/typecheck.mjs",
    "lint": "node scripts/typecheck.mjs",
    "docs:dev": "pnpm --filter dualscreen-docs dev",
    "docs:build": "pnpm build && pnpm --filter dualscreen-docs build",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo examples/*/dist docs/.vitepress/dist docs/.vitepress/cache docs/public/demo",
    "demo": "pnpm --filter dualscreen-playground dev",
    "demo:build": "DEMO_BASE=/demo/ pnpm --filter dualscreen-playground build && rm -rf docs/public/demo && mkdir -p docs/public && cp -r examples/playground/dist docs/public/demo",
    "site:build": "pnpm build && pnpm docs:check && pnpm demo:build && pnpm --filter dualscreen-docs build",
    "site:preview": "pnpm --filter dualscreen-docs preview",
    "docs:check": "node scripts/check-docs-html.mjs"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "happy-dom": "^15.11.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
